# Local development — Docker Compose reads this file
# Do NOT commit this file

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=""
PORT=
TRUSTED_PROXIES=""

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL Configuration for Docker Compose
POSTGRES_HOST=""
POSTGRES_PORT=
POSTGRES_APP_DB=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# PgBouncer Configuration for Docker Compose
PGBOUNCER_PORT=
PGBOUNCER_POOL_MODE=""
PGBOUNCER_MAX_CLIENT_CONN=
PGBOUNCER_DEFAULT_POOL_SIZE=
PGBOUNCER_MIN_POOL_SIZE=
PGBOUNCER_RESERVE_POOL_SIZE=
PGBOUNCER_MAX_DB_CONNECTIONS=
PGBOUNCER_SERVER_IDLE_TIMEOUT=
PGBOUNCER_SERVER_LIFETIME=

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Direct PostgreSQL URL (no pooling) — use for migrations
DATABASE_URL=""

# PgBouncer pooled URL — use for application runtime
DATABASE_POOL_URL=""

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=""
JWT_EXPIRE=""
JWT_TOKEN_ISSUER=""
JWT_TOKEN_AUDIENCE=""
# JWT_ALGORITHM options (HMAC only): HS256 | HS384 | HS512
JWT_ALGORITHM=""

# -----------------------------------------------------------------------------
# Session / Refresh token
# -----------------------------------------------------------------------------
# SESSION_STORE=db     — persist sessions in Postgres (default)
# SESSION_STORE=redis  — cache sessions in Redis only
# SESSION_STORE=hybrid — Redis as write-through cache; miss → DB fallback → re-populate Redis
SESSION_STORE="db"
REFRESH_EXPIRE_HOURS=168

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis Configuration for Docker Compose
REDIS_HOST=""
REDIS_PORT=
REDIS_USERNAME=""
REDIS_PASSWORD=""

REDIS_URL=""
