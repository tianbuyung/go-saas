#!/bin/sh

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Ignore merge commits
case "$commit_msg" in
  Merge*) exit 0 ;;
esac

# Conventional commits pattern: type(scope): description
pattern="^(feat|fix|refactor|test|chore|docs|style|perf|ci|build|revert)(\(.+\))?!?: .+"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "Invalid commit message format."
  echo ""
  echo "Expected: <type>(<scope>): <description>"
  echo "Example:  feat(auth): add refresh token rotation"
  echo ""
  echo "Allowed types: feat fix refactor test chore docs style perf ci build revert"
  echo "Scope is optional but recommended."
  echo ""
  exit 1
fi

# Subject line length check (max 100 chars)
subject=$(echo "$commit_msg" | head -n 1)
if [ ${#subject} -gt 100 ]; then
  echo ""
  echo "Commit subject too long (${#subject} chars) — max 100."
  echo ""
  exit 1
fi
